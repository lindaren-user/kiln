# Copy this file to /opt/kiln/.env on the server. Deployment never overwrites .env.
# Passwords must be hex or letters only. Characters such as @ : / # break the database URL.

# Filled in by deploy/kiln/remote-deploy.sh. The placeholder is replaced on the first deploy.
KILN_IMAGE=ghcr.io/your-name/kiln:unset

# Public site name, without https:// and without a path. Example: kiln.example.com
KILN_DOMAIN=kiln.example.com

POSTGRES_USER=kiln
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_DB=kiln

# openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Optional Cloudflare R2 storage for quick-generate reference media.
# Create an R2 API token limited to this bucket with Object Read & Write.
# QUICK_GENERATE_UPLOAD_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# QUICK_GENERATE_UPLOAD_S3_BUCKET=quick-generate
# QUICK_GENERATE_UPLOAD_S3_REGION=auto
# QUICK_GENERATE_UPLOAD_S3_ACCESS_KEY=replace-me
# QUICK_GENERATE_UPLOAD_S3_SECRET_KEY=replace-me
# QUICK_GENERATE_UPLOAD_S3_PREFIX=quick-generate
# Signed URL lifetime in seconds; must be long enough for the provider to fetch input media.
# QUICK_GENERATE_UPLOAD_URL_TTL_SECONDS=21600
